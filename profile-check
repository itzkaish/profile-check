<!doctype html>
<html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>NEXUS // SECURE TERMINAL</title>
<style>
*{box-sizing:border-box}html,body{margin:0;min-height:100%;background:#020604;color:#8cff9b;font-family:monospace}body{display:flex;justify-content:center}.wrap{width:min(720px,100%);min-height:100vh;padding:24px 18px 36px;border-left:1px solid #163d24;border-right:1px solid #163d24}.header{font-size:22px;color:#eee;margin-bottom:24px}.badge{color:#ff5b5b;font-size:12px;margin-bottom:18px;letter-spacing:2px}#logs{min-height:235px;font-size:16px;line-height:1.8}.line{opacity:0;animation:appear .45s forwards}@keyframes appear{to{opacity:1}}.warn{color:#ffd36b}.progress{margin-top:14px;height:18px;border:1px solid #245c35;border-radius:12px;padding:2px;opacity:0}.bar{height:100%;width:0;background:#25b95a;border-radius:10px;box-shadow:0 0 14px #25b95a;animation:fill 5s linear forwards}@keyframes fill{to{width:100%}}.status{margin-top:20px;font-size:16px;opacity:0}.photoBox{margin-top:26px;border:2px solid #315e3d;border-radius:18px;padding:20px;opacity:0;transform:scale(.96);overflow:hidden}.photoTitle{color:#6b9875;font-size:14px;letter-spacing:1px;margin-bottom:12px}.photo{width:100%;display:block;border-radius:12px;opacity:0;filter:brightness(.15) saturate(.3);animation:photoReveal 2.5s ease forwards}@keyframes photoReveal{0%{opacity:0;filter:brightness(.05) saturate(0)}60%{opacity:.55;filter:brightness(.45) saturate(.5)}100%{opacity:1;filter:none}}.scanline{position:absolute;left:0;right:0;height:3px;background:#48ff78;box-shadow:0 0 16px #48ff78;top:0;animation:scan 2.3s ease-in-out infinite}.photoWrap{position:relative;overflow:hidden;border-radius:12px}@keyframes scan{0%{top:0}100%{top:calc(100% - 3px)}}.reveal{margin-top:30px;text-align:center;border-top:1px solid #294b32;padding-top:25px;opacity:0;transform:translateY(15px)}.revealText{font-size:clamp(34px,9vw,68px);font-weight:bold;color:#fff;text-shadow:0 0 18px #48ff78}.show{animation:show .7s forwards}@keyframes show{to{opacity:1;transform:none}}
</style></head>
<body><div class="wrap"><div class="header">NEXUS // SECURE TERMINAL</div><div class="badge">● LIVE SCAN SEQUENCE</div><div id="logs"></div><div class="progress" id="progress"><div class="bar"></div></div><div class="status" id="status">[100%] Scan complete.</div>
<div class="photoBox" id="photoBox"><div class="photoTitle">TARGET PREVIEW // PHOTO</div><div class="photoWrap"><img class="photo" src="data:image/jpeg;base64,"><div class="scanline"></div></div></div>
<div class="reveal" id="reveal"><div class="photoTitle">FINAL MESSAGE</div><div class="revealText">CHUTIYE HO 😂</div></div></div>
<script>
const lines=["[SYS ] Initializing secure terminal...","[AUTH] Establishing virtual session...","[SCAN] Checking security layers...","[SCAN] Analyzing target profile...","[SCAN] Running deep scan sequence...","[AUTH] Verifying session...","[DATA] Processing simulated blocks...","[WARN] Suspicious activity detected","[OK  ] Final scan sequence running..."];
const logs=document.getElementById('logs'),progress=document.getElementById('progress'),status=document.getElementById('status'),photoBox=document.getElementById('photoBox'),reveal=document.getElementById('reveal');
lines.forEach((t,i)=>setTimeout(()=>{const d=document.createElement('div');d.className='line '+(t.includes('[WARN]')?'warn':'');d.textContent=t;logs.appendChild(d)},i*700));
setTimeout(()=>progress.style.opacity=1,6600);setTimeout(()=>status.classList.add('show'),12200);setTimeout(()=>photoBox.classList.add('show'),13200);setTimeout(()=>reveal.classList.add('show'),16400);
</script></body></html>
